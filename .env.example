# AHS Command Center — copy to .env.local (never commit .env.local)
# Public Firebase client config (safe for browser, but keep in env for rotation)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Bootstrap admin (comma-separated emails). Used ONLY to resolve the first
# super-admin before its users doc exists. Create the users doc + Firebase Auth
# user immediately, then this is just a fallback.
SUPER_ADMIN_EMAILS=
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=

# Firebase AdminSDK (server-only, REQUIRED in production / Vercel)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional local dev alternative to env vars (gitignored, dev only):
# FIREBASE_ADMIN_KEY_PATH=./serviceAccountKey.json

# Email campaigns (server-only)
EMAIL_PROVIDER=smtp
EMAIL_TEST_MODE=false
EMAIL_TEST_ADDRESS=
EMAIL_FROM_NAME=AHS Global Services
EMAIL_FROM_ADDRESS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_RATE_LIMIT_PER_MINUTE=30
EMAIL_BATCH_SIZE=10
# REQUIRED for /api/email-campaigns/webhook — provider must send this as x-webhook-secret
EMAIL_WEBHOOK_SECRET=

# AI test review (server-only, optional). Powers "AI check" on daily-test import.
# Get a free key at Google AI Studio (aistudio.google.com) → set in Vercel → redeploy.
GEMINI_API_KEY=
