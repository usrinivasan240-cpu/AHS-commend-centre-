# Email Campaign - Server-side only (NEVER expose to client, never commit secrets)
# Copy to .env.local and fill required vars for your provider

# Provider selection: mock | console | smtp | api
# mock = in-memory success (development), console = logs only (test mode), smtp = Nodemailer, api = generic HTTP API
EMAIL_PROVIDER=mock

# Test mode - when true, no real leads receive emails; routes to console/test address
EMAIL_TEST_MODE=true
EMAIL_TEST_ADDRESS=test@ahs.dev

# Common sender defaults (can also be overridden per campaign)
EMAIL_FROM_NAME=AHS Global Services
EMAIL_FROM_ADDRESS=ahsglobalservices@gail.com

# SMTP provider (when EMAIL_PROVIDER=smtp) - use app password / authorized sending mechanism for ahsglobalservices@gail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=ahsglobalservices@gail.com
EMAIL_PASSWORD=your_app_password_here

# Generic API provider (when EMAIL_PROVIDER=api) e.g., Resend/Brevo/SES wrapper
EMAIL_API_URL=https://api.example.com/send
EMAIL_API_KEY=your_api_key_here

# Rate limiting
EMAIL_RATE_LIMIT_PER_MINUTE=30
EMAIL_BATCH_SIZE=10

# App URL for unsubscribe links
NEXT_PUBLIC_APP_URL=http://localhost:5000
